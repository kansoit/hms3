FROM python:3.11-bookworm AS builder

# Instalar repositorio oficial de Microsoft ODBC Driver 18
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY application/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY application/ .

# Etapa final liviana
FROM python:3.11-slim-bookworm
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg2 \
    ca-certificates \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && apt-get purge -y --auto-remove curl gnupg2 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash appuser

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app .

# Colectar estáticos (sin base de datos: HMS_ALLOW_SQLITE solo vale para este paso)
RUN HMS_ALLOW_SQLITE=1 python manage.py collectstatic --noinput

# Commit del repo con el que se construyó la imagen (lo pasa hms-ctl.py build).
# Se ve en el pie de la app, en /api/health/ y en hms-ctl.py status.
ARG HMS_BUILD=unknown
ENV HMS_BUILD=${HMS_BUILD}
LABEL org.hms3.build=${HMS_BUILD}

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
# --timeout 60: un worker colgado (por ejemplo, base que no responde) se recicla solo.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60", "hms_project.wsgi:application"]
