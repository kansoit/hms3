# Destino de build-and-push.sh. Copiar a .env-registry (queda fuera de git) y completar.
# Formato: <host>:<puerto>/<grupo>/<proyecto>/<imagen>, sin tag.
HMS_REGISTRY_IMAGE=registry.example.com:5050/usuario/hms3/hms3-app
