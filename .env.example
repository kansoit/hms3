# ====================================================================
# HMS 3.0 - Master Environment Configuration Template
# Copy this file to .env-<environment>-<country> and fill in your credentials.
# Example: cp .env.example .env-prod-ar
# ====================================================================

# Core Django Configuration
DJANGO_SECRET_KEY=hms3-secret-key-replace-in-production
ALLOWED_HOSTS=*
DEBUG=True

# Environment & Localization
# HMS_ENV: 'prod' (mapped to port 8012) or 'test' (mapped to port 8013)
HMS_ENV=prod
# HMS_COUNTRY: 'AR' (Argentina), 'BR' (Brazil), or 'US' (United States)
HMS_COUNTRY=AR
# HMS_CONTAINER_NAME: 'hms3_prod' or 'hms3_test'
HMS_CONTAINER_NAME=hms3_prod
# HOST_PORT: Port exposed on host (8012 for prod, 8013 for test)
HOST_PORT=8012

# SQL Server Instance Connection
DB_HOST=10.0.0.10
DB_PORT=1433
DB_NAME=hms3_ar
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere
